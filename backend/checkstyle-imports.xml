<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
	"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
	"https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
	Imports only, and WARNINGS ONLY. This file exists because Spotless can only
	rewrite code, never report on it: import hygiene is something to be told
	about and fix by hand, not to have silently changed under you.

	The severity split is deliberate and enforced in two places:
	  * formatting  -> `mvn spotless:check`, exits non-zero, GATES CI
	  * imports     -> this file, severity=warning + <failOnViolation>false</failOnViolation>,
	                   can never fail a build, surfaces as GitHub ::warning annotations

	So do not add a formatting/style module here, and do not raise the severity.
	If something in here should block a merge, it belongs in the formatter
	instead.
-->
<module name="Checker">
	<property name="severity" value="warning"/>
	<!-- Checkstyle defaults to ISO-8859-1; .editorconfig says utf-8. -->
	<property name="charset" value="UTF-8"/>
	<property name="fileExtensions" value="java"/>

	<module name="TreeWalker">
		<!--
			76 of the 1665 imports in backend/src are wildcards, across 59 files,
			all in src/main. Ten of them are `import static` in the *Factory
			classes (SimilarityScipyFactory, RecommendationFactory, Strategy,
			...), which pull in type-string constants on purpose - that is the
			registry pattern the codebase is built on, so static wildcards are
			allowed and only regular ones are reported.
		-->
		<module name="AvoidStarImport">
			<property name="allowStaticMemberImports" value="true"/>
		</module>

		<!--
			Known false positive: an import referenced only from a Javadoc
			{@link} is reported as unused. Harmless here because nothing in
			this file can fail a build - it costs a line of log noise, not a
			red check.
		-->
		<module name="UnusedImports">
			<property name="processJavadoc" value="true"/>
		</module>

		<module name="RedundantImport"/>
	</module>
</module>
